				{
					"name": "CreateBooking Copy",
					"event": [
						{
							"listen": "test",
							"script": {
								"id": "eab4ba2b-aadc-45b3-ae73-e8bd7e13b8e2",
								"exec": [
									"var allData = JSON.parse(pm.environment.get(\"allData\"));\r",
									"var idx = parseInt(pm.environment.get(\"runIndex\"), 10);\r",
									"\r",
									"var current = allData[idx];\r",
									"\r",
									"if (!current) {\r",
									"    console.log(\"No more data to run\");\r",
									"} else {\r",
									"\r",
									"    console.log(`Running iteration ${idx}:`, current);\r",
									"\r",
									"    let requestOptions = {\r",
									"        url: pm.request.url.toString(),\r",
									"        method: pm.request.method,\r",
									"        header: pm.request.headers,\r",
									"        body: {\r",
									"            mode: \"raw\",\r",
									"            raw: JSON.stringify({\r",
									"                firstname: current.fname,\r",
									"                lastname: current.lname,\r",
									"                totalprice: 1111,\r",
									"                depositpaid: true,\r",
									"                bookingdates: {\r",
									"                    checkin: \"2026-02-01\",\r",
									"                    checkout: \"2026-02-02\"\r",
									"                },\r",
									"                additionalneeds: \"super bowls more\"\r",
									"            })\r",
									"        }\r",
									"    };\r",
									"\r",
									"    pm.sendRequest(requestOptions, function (err, response) {\r",
									"\r",
									"    if (err) {\r",
									"        console.error(\"Request error:\", err);\r",
									"    } else {\r",
									"\r",
									"        console.log(\"Response status:\", response.code);\r",
									"\r",
									"        // only parse JSON if status is 200\r",
									"        if (response.code === 200) {\r",
									"\r",
									"            let body = response.json(); // safe now\r",
									"            console.log(\"Response body:\", body);\r",
									"\r",
									"            pm.test(\"Status is 200\", () => {\r",
									"                pm.expect(response).to.have.status(200);\r",
									"            });\r",
									"\r",
									"            pm.test(\"Firstname matches\", () => {\r",
									"                pm.expect(body.booking.firstname).to.eql(current.fname);\r",
									"            });\r",
									"\r",
									"            pm.test(\"Lastname matches\", () => {\r",
									"                pm.expect(body.booking.lastname).to.eql(current.lname);\r",
									"            });\r",
									"\r",
									"        } else {\r",
									"            console.warn(\"Skipping JSON parse — status not 200\");\r",
									"        }\r",
									"    }\r",
									"\r",
									"    // move to next\r",
									"    pm.environment.set(\"runIndex\", idx + 1);\r",
									"});\r",
									"\r",
									"}\r",
									""
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
